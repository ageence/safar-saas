generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN  
  AGENCY_ADMIN 
  EMPLOYEE     
}

model Agency {
  id        String   @id @default(cuid())
  name      String   
  slug      String   @unique 
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]   
  clients   Client[] 
  offers    Offer[]
  bookings  Booking[]
  visas     VisaApplication[] 
  payments  Payment[] 
  expenses  Expense[] 
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   
  name      String
  role      Role     @default(EMPLOYEE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agencyId  String?  
  agency    Agency?  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
}

model Client {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  phone     String
  email     String?
  source    String
  status    String   @default("PROSPECT")
  notes     String?
  
  // 👇 AJOUTE CETTE LIGNE EXACTEMENT ICI 👇
  passport  String?
  // 👆 👆 👆 👆 👆

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  visas     VisaApplication[]
}

model Offer {
  id             String   @id @default(cuid())
  title          String   
  destination    String
  type           String   
  imageUrl       String?
  price          Float    
  totalSeats     Int?     
  availableSeats Int?     
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
// 👇 LES 4 NOUVELLES COLONNES À AJOUTER 👇
  startDate      DateTime?
  endDate        DateTime?
  totalSpots     Int?
  availableSpots Int?
  // 👆 👆 👆 👆 👆
  agencyId       String
  agency         Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  bookings       Booking[]
}

model Booking {
  id          String   @id @default(cuid())
  status      String   @default("EN_ATTENTE") 
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  offerId     String
  offer       Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  
  payments    Payment[] 
documents   Document[]
}

// 1. LE NOUVEAU MODÈLE VISA
model VisaApplication {
  id              String   @id @default(cuid())
  country         String   
  type            String   @default("Touristique")
  price           Float    @default(0)
  status          String   @default("EN_ATTENTE") 
  
  appointmentDate DateTime? 
  appointmentLink String?
  notes           String?
  
  identityPhoto   String?
  videoUrl        String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agencyId        String
  agency          Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  payments        Payment[]
  documents       Document[]
}

// 2. METS À JOUR LA TABLE PAYMENT (Ajoute les 2 lignes Visa)
model Payment {
  id          String   @id @default(cuid())
  amount      Float
  method      String   
  reference   String?  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookingId   String?
  booking     Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  
  // 👇 AJOUTE CES 2 LIGNES 👇
  visaId      String?
  visa        VisaApplication? @relation(fields: [visaId], references: [id], onDelete: Cascade)

  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientId    String?
}
// Table des Dépenses (Sorties d'argent)
model Expense {
  id          String   @id @default(cuid())
  amount      Float
  category    String   
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agencyId    String
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
}
// 3. METS À JOUR LA TABLE DOCUMENT (Ajoute les 2 lignes Visa et met un ? au bookingId)
model Document {
  id          String   @id @default(cuid())
  name        String   
  fileUrl     String?
  createdAt   DateTime @default(now())

  bookingId   String?  // <--- N'oublie pas le point d'interrogation ici !
  booking     Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  
  // 👇 AJOUTE CES 2 LIGNES 👇
  visaId      String?
  visa        VisaApplication? @relation(fields: [visaId], references: [id], onDelete: Cascade)
}